# =============================================================================
# web / Next.js — LOCAL DEVELOPMENT
# Tracked in git. Non-secret defaults; a clean clone runs with no edits.
#
# NEXT_PUBLIC_* is inlined into the JavaScript bundle at build time and is
# readable by anyone who opens the page. Never put a secret behind that prefix.
# =============================================================================

APP_ENV=development

# --- Supabase (browser-facing; must be reachable from the host, not the container)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon key: an HS256 JWT carrying `role: anon`, signed with JWT_SECRET. The
# `sb_publishable_` format the CLI issues is resolved by Kong, which this stack
# does not run — self-hosted GoTrue and PostgREST verify the signature instead.
# It is RLS-constrained and grants nothing off this machine.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI3NTg0MDB9.-klD3_pvFOioB6hf2pRPA5AVn4fI3oy-yQ7-iDZVNOg

# --- Backend API (Deno + Hono) ----------------------------------------------
# Default local path: the `api` container from docker-compose, which runs the
# identical Hono app as supabase/functions/api.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:54331/api
#
# Alternative, to exercise the real Supabase edge runtime:
#   supabase functions serve --env-file supabase/functions/.env.development
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api

# --- Server-side only (not exposed to the browser) --------------------------
# Server components run inside the container, where 127.0.0.1 is the container
# itself rather than the gateway. compose.yml overrides this with the gateway's
# service name; the value here is what a bare `bun run dev` on the host needs.
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321

# --- docker compose orchestration -------------------------------------------
# Read by `docker compose --env-file` for interpolation in compose.yml, not by
# Next.js itself. It lives here because the port it names is this stack's.
WEB_PORT=3000
