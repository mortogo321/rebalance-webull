# =============================================================================
# web / Next.js — UAT (EC2)
# Tracked in git: non-secret configuration only.
#
# Blank values are injected at image-build time from CI variables.
# NEXT_PUBLIC_* must be present at BUILD time,
# not just at runtime — Next.js inlines them into the client bundle, so a value
# supplied only at `docker run` arrives too late and the browser sees undefined.
# =============================================================================

APP_ENV=uat

# --- Supabase (browser-facing) ----------------------------------------------
# variable: NEXT_PUBLIC_SUPABASE_URL_UAT
NEXT_PUBLIC_SUPABASE_URL=
# variable: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_UAT
# Publishable, not secret: RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Backend API ------------------------------------------------------------
# variable: NEXT_PUBLIC_API_BASE_URL_UAT
# Served by nginx on the same host, so the browser is same-origin and no CORS
# preflight is needed: https://<uat-host>/functions/v1/api
NEXT_PUBLIC_API_BASE_URL=

# --- Server-side only -------------------------------------------------------
SUPABASE_INTERNAL_URL=http://api-gateway:8000

# --- docker compose orchestration -------------------------------------------
# Read by `docker compose --env-file`, not by Next.js. Behind nginx, so this
# port is published on the host loopback only, never to the internet.
WEB_PORT=3000
