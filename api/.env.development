# =============================================================================
# api / rebalance engine — LOCAL DEVELOPMENT
# Tracked in git. Values here are non-secret defaults for a throwaway local
# stack; a clean clone runs with no edits. Override anything in .env.local.
# =============================================================================

APP_ENV=development
LOG_LEVEL=DEBUG

# --- Postgres (service-role connection, bypasses RLS) -----------------------
# Container-to-container: the compose service name, not 127.0.0.1. Postgres is
# defined in compose.yml, so `docker compose up engine` brings up its own
# database; from the host the same server is on ${POSTGRES_PORT:-54322}.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=8

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=http://gateway:8000
# An HS256 JWT carrying `role: service_role`, signed with the secret compose.yml
# gives gotrue and postgrest. It grants nothing outside this machine, which is
# why it can live in git. (Declared for completeness — config.py reads it, but
# the engine reaches Postgres directly and never calls the Supabase API.)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4Mjc1ODQwMH0.UFIeqfTUtbWGI1xWT1AfG04fDQXYzmYXUsAo8lAgAk4

# --- Credential encryption --------------------------------------------------
# DEV ONLY. This is base64 of the bytes 0..31 — deliberately not random, so it
# can never be mistaken for a real key. uat/production get a generated key from
# a CI variable. Must match the edge functions' APP_ENCRYPTION_KEY.
APP_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
APP_ENCRYPTION_KEY_VERSION=1

# --- Internal service auth (edge functions -> engine) -----------------------
ENGINE_INTERNAL_TOKEN=dev-internal-token-not-a-secret

# --- Broker -----------------------------------------------------------------
# mock = deterministic paper broker. Never reaches a real venue.
BROKER_MODE=mock
WEBULL_BASE_URL=
WEBULL_ALLOWED_HOSTS=uat-api.webull.co.th,sandbox-api.webull.co.th,localhost,127.0.0.1
WEBULL_REQUEST_TIMEOUT_SECONDS=10

# --- Mock broker ------------------------------------------------------------
MOCK_STARTING_CASH=100000
MOCK_PRICE_SEED=20260101
MOCK_PRICE_VOLATILITY_BPS=150

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=15
MAX_ORDERS_PER_RUN=25

# --- docker compose orchestration -------------------------------------------
# Read by `docker compose --env-file` for interpolation in compose.yml, not by
# the engine itself. It lives here because the port it names is this stack's.
ENGINE_PORT=8000
