# =============================================================================
# api / rebalance engine — PRODUCTION
# Tracked in git: non-secret configuration only.
#
# Blank values are REQUIRED and injected at deploy time from GitHub Actions
# secrets (see .github/workflows/cd.yml). infra/deploy/deploy.sh refuses to
# start a container while any of them is still empty, so a half-configured
# release fails on the server instead of running with a broken default.
# =============================================================================

APP_ENV=production
LOG_LEVEL=WARNING

# --- Postgres (hosted Supabase project, pooled connection) ------------------
# secret: SUPABASE_DB_URL
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Supabase ---------------------------------------------------------------
# secret: SUPABASE_URL_PROD
SUPABASE_URL=
# secret: SUPABASE_SECRET_KEY_PROD
SUPABASE_SECRET_KEY=

# --- Credential encryption --------------------------------------------------
# secret: APP_ENCRYPTION_KEY_PROD — generate with ./infra/scripts/gen-keys.sh
# Rotating this without re-encrypting stored rows makes every saved broker
# credential unreadable. Rotate by re-encrypting every row under the new key
# first, then bumping APP_ENCRYPTION_KEY_VERSION.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1

# --- Internal service auth --------------------------------------------------
# secret: ENGINE_INTERNAL_TOKEN_PROD
ENGINE_INTERNAL_TOKEN=

# --- Broker -----------------------------------------------------------------
# This POC never trades production. The allowlist below contains no
# production host, so even setting BROKER_MODE=webull_uat here can only
# reach a UAT venue. Removing that guard is a deliberate, reviewed change.
BROKER_MODE=mock
WEBULL_BASE_URL=https://uat-api.webull.co.th
# Hard allowlist. A base URL outside this list aborts startup — a typo or a bad
# variable can never point this deployment at production.
WEBULL_ALLOWED_HOSTS=uat-api.webull.co.th,sandbox-api.webull.co.th
WEBULL_REQUEST_TIMEOUT_SECONDS=15

# --- Mock broker (used only while BROKER_MODE=mock) -------------------------
MOCK_STARTING_CASH=100000
MOCK_PRICE_SEED=20260101
MOCK_PRICE_VOLATILITY_BPS=150

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
MAX_ORDERS_PER_RUN=25

# --- docker compose orchestration -------------------------------------------
# Read by `docker compose --env-file`, not by the engine. Behind nginx, so this
# port is published on the host loopback only, never to the internet.
ENGINE_PORT=8000
