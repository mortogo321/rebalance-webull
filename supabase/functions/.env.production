# =============================================================================
# Edge functions — PRODUCTION
# Tracked in git: non-secret configuration only.
#
# Blank values are injected at deploy time:
#   hosted functions -> `supabase secrets set`
#   EC2 container    -> compose environment, from CI secrets
# =============================================================================

APP_ENV=production

# secret: APP_ENCRYPTION_KEY_PROD — must be byte-identical to the engine's.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1

# On EC2 the engine is a sibling container behind the same nginx; the active
# blue/green colour is resolved by the compose service alias, not hardcoded.
ENGINE_URL=http://engine:8000
# secret: ENGINE_INTERNAL_TOKEN_PROD
ENGINE_INTERNAL_TOKEN=
ENGINE_TIMEOUT_MS=20000

# variable: PROD_PUBLIC_URL — the browser is same-origin behind nginx, so this
# is a safety net rather than the main path.
CORS_ALLOWED_ORIGINS=

# Only needed by the containerised runtime; hosted functions inject these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- docker compose orchestration -------------------------------------------
# Read by `docker compose --env-file`, not by the edge function.
COMPOSE_PROJECT_NAME=rebalance-prod
