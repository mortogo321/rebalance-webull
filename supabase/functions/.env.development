# =============================================================================
# Edge functions — LOCAL DEVELOPMENT
# Loaded by: supabase functions serve --env-file supabase/functions/.env.development
# Tracked in git: non-secret local defaults only.
#
# SUPABASE_URL / SUPABASE_*_KEY are injected automatically by the local edge
# runtime, so they are absent here on purpose. The container build (Dockerfile)
# is the case that needs them set explicitly.
# =============================================================================

APP_ENV=development

# Must match api/.env.development — the engine decrypts what this encrypts.
APP_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
APP_ENCRYPTION_KEY_VERSION=1

# The engine is reachable on the compose network by service name.
ENGINE_URL=http://engine:8000
ENGINE_INTERNAL_TOKEN=dev-internal-token-not-a-secret
ENGINE_TIMEOUT_MS=15000

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- local Supabase stack ----------------------------------------------------
# HS256 JWTs carrying `role`, signed with JWT_SECRET below. compose.yml runs
# GoTrue and PostgREST directly rather than behind Kong, and they verify a
# signature — the CLI's `sb_secret_`/`sb_publishable_` format is a Kong concept
# and is not understood by either. Scoped to this machine, hence tracked.
#
# compose.yml overrides SUPABASE_URL with the gateway's service name; the value
# here is what `supabase functions serve` on the host needs.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4Mjc1ODQwMH0.UFIeqfTUtbWGI1xWT1AfG04fDQXYzmYXUsAo8lAgAk4
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI3NTg0MDB9.-klD3_pvFOioB6hf2pRPA5AVn4fI3oy-yQ7-iDZVNOg

# The secret these are signed with is not here: it is consumed only by the
# gotrue and postgrest services and is set on them in compose.yml. This app
# never verifies a token itself — _shared/auth.ts calls getUser() against
# GoTrue over HTTP, so SUPABASE_URL above is all it needs.

# --- docker compose orchestration -------------------------------------------
# Read by `docker compose --env-file` for interpolation in compose.yml, not by
# the edge function. The Supabase CLI owns the project id, so it lives with the
# Supabase stack.
SUPABASE_PROJECT_ID=rebalance-webull
COMPOSE_PROJECT_NAME=rebalance-webull
